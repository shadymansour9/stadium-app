rules_version = '2';

// STADIUM - Firestore Security Rules
// Deploy with: firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }

    // A real account, not a guest. Guests are signed in anonymously so they
    // can look at courts and times, but cannot book, join or register.
    function isMember() {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Owner of the whole app. Must match kOwnerEmail in lib/main.dart. Requires
    // a verified email, so registering with this address grants nothing.
    function isOwner() {
      return isSignedIn()
        && request.auth.token.email == 'mansourshady69@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Admin over everything = the owner. Courts and their admins are all
    // set up from the owner's screen; there are no built-in admin accounts.
    function isAdmin() {
      return isOwner();
    }

    // Court admin: appointed by the owner in court_admins/{email}, limited to
    // the listed courts. Also needs a verified email: an appointment is only
    // an email address, so anyone could otherwise register with it first.
    function managesStadium(stadiumId) {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/court_admins/$(request.auth.token.email))
        && stadiumId in get(/databases/$(database)/documents/court_admins/$(request.auth.token.email)).data.stadiumIds;
    }

    // 1) USERS - each user reads/writes only their own profile.
    match /users/{uid} {
      allow read:   if isSignedIn() && request.auth.uid == uid;
      allow create: if isMember() && request.auth.uid == uid;
      allow update: if isMember() && request.auth.uid == uid;
      allow delete: if isMember() && request.auth.uid == uid;
    }

    // Padel/tennis bookings carry `maxPlayers`; football bookings don't, so
    // these checks are no-ops for them (football behaviour unchanged).
    function withinMaxPlayers() {
      return !('maxPlayers' in request.resource.data)
        || request.resource.data.players.size() <= request.resource.data.maxPlayers;
    }
    function maxPlayersUnchanged() {
      return !('maxPlayers' in resource.data)
        || request.resource.data.get('maxPlayers', null) == resource.data.maxPlayers;
    }

    // 2) BOOKINGS - signed-in users see availability and join with codes.
    match /bookings/{bookingId} {
      allow read:   if isSignedIn();
      allow create: if isMember() && withinMaxPlayers()
        && (isAdmin() || managesStadium(request.resource.data.get('stadiumId', ''))
            || (request.resource.data.get('paymentStatus', 'unpaid') == 'unpaid'
                && !('paidAmount' in request.resource.data)));
      allow update: if isMember() && (
        resource.data.userId == request.auth.uid
        || isAdmin()
        || managesStadium(resource.data.get('stadiumId', ''))
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players', 'playerIds'])
      ) && (isAdmin() || (withinMaxPlayers() && maxPlayersUnchanged()))
        // Paid / not paid is the court admin's call, not the player's.
        && (isAdmin() || managesStadium(resource.data.get('stadiumId', ''))
            || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['paymentStatus', 'paidAt', 'paidAmount', 'paidBy']));
      allow delete: if isMember() && (
        resource.data.userId == request.auth.uid
        || isAdmin()
        || managesStadium(resource.data.get('stadiumId', ''))
      );
    }

    // Clubs and courts added from the owner's screen. A doc with the id of a
    // code-defined club or court overrides it (active:false hides it).
    match /venues/{venueId} {
      allow read:  if isSignedIn();
      allow write: if isOwner();
    }
    match /stadiums/{stadiumId} {
      allow read:  if isSignedIn();
      allow write: if isOwner();
      // The court's admin sets its price, opening hours and booking length.
      allow update: if managesStadium(stadiumId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['pricePerHour', 'price', 'openTime', 'closeTime', 'slotMinutes', 'maxPlayers', 'contactPhone',
                       'payCash', 'payPaybox', 'payboxLink', 'address', 'mapsLink', 'amenities', 'thumb']);
    }

    // A court's photos (base64 JPEG): anyone signed in sees them; the
    // owner and the court's admin change them.
    match /court_photos/{courtId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin() || managesStadium(courtId);
    }

    // Which courts each admin manages. Doc id is the lowercased email.
    match /court_admins/{email} {
      allow read:  if isOwner() || (isSignedIn() && request.auth.token.email == email);
      allow write: if isOwner();
    }

    // 3) ADMIN_SCHEDULE - per-stadium per-day overrides.
    match /admin_schedule/{docId} {
      allow read:  if isSignedIn();
      // Doc id is {stadiumId}_{yyyy-MM-dd}: the last 11 characters are the date.
      allow write: if isAdmin() || managesStadium(docId[0:docId.size() - 11]);
    }

    // 4) NOTIFICATIONS - each user reads/writes only their own.
    match /notifications/{notifId} {
      allow read:   if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isMember();
      allow update: if isMember() && resource.data.userId == request.auth.uid;
      allow delete: if isMember() && resource.data.userId == request.auth.uid;
    }

    // 5) RECURRING_BLOCKS - weekly fixed reservations.
    match /recurring_blocks/{blockId} {
      allow read:  if isSignedIn();
      allow create: if isAdmin() || managesStadium(request.resource.data.get('stadiumId', ''));
      allow update: if isAdmin() || (
        managesStadium(resource.data.get('stadiumId', ''))
        && managesStadium(request.resource.data.get('stadiumId', ''))
      ) || (
        // The player it belongs to can free single dates ("not coming").
        isMember() && resource.data.get('userId', '') == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['skipDates'])
      );
      allow delete: if isAdmin() || managesStadium(resource.data.get('stadiumId', ''));
    }

    // Booking types (per-stadium configurable types).
    match /booking_types/{typeId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // Training groups (kids' programs). A court admin runs the school of
    // the courts they manage.
    match /training_groups/{groupId} {
      allow read:   if isSignedIn();
      allow create: if isAdmin() || managesStadium(request.resource.data.get('stadiumId', ''));
      allow update: if isAdmin() || (
        managesStadium(resource.data.get('stadiumId', ''))
        && managesStadium(request.resource.data.get('stadiumId', ''))
      );
      allow delete: if isAdmin() || managesStadium(resource.data.get('stadiumId', ''));

      // Taken spots, without personal details, so parents can see how many
      // are left. Created together with the parent's own registration.
      match /seats/{regId} {
        allow read:   if isSignedIn();
        allow create: if isMember()
          && request.resource.data.parentUserId == request.auth.uid
          && getAfter(/databases/$(database)/documents/training_registrations/$(regId)).data.parentUserId == request.auth.uid
          && getAfter(/databases/$(database)/documents/training_registrations/$(regId)).data.groupId == groupId;
        allow delete: if isMember() && (
          resource.data.parentUserId == request.auth.uid || isAdmin()
          || managesStadium(get(/databases/$(database)/documents/training_groups/$(groupId)).data.get('stadiumId', ''))
        );
      }
    }

    // Parents register kids - parents see/manage their own; admins manage all.
    match /training_registrations/{regId} {
      allow read:   if isSignedIn() && (
        resource.data.parentUserId == request.auth.uid || isAdmin()
        || managesStadium(resource.data.get('stadiumId', ''))
      );
      allow create: if isMember()
        && request.resource.data.parentUserId == request.auth.uid;
      allow update: if isMember() && (
        resource.data.parentUserId == request.auth.uid || isAdmin()
        || managesStadium(resource.data.get('stadiumId', ''))
      );
      allow delete: if isMember() && (
        resource.data.parentUserId == request.auth.uid || isAdmin()
        || managesStadium(resource.data.get('stadiumId', ''))
      );
    }

    // Players ask for the same time every week; the court's admin approves
    // (creating a recurring block) or declines.
    match /fixed_requests/{reqId} {
      allow read:   if isMember() && (
        resource.data.userId == request.auth.uid || isAdmin()
        || managesStadium(resource.data.get('stadiumId', ''))
      );
      allow create: if isMember()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isAdmin() || managesStadium(resource.data.get('stadiumId', ''));
      allow delete: if isMember() && (
        resource.data.userId == request.auth.uid || isAdmin()
        || managesStadium(resource.data.get('stadiumId', ''))
      );
    }

    // Venue / stadium background images.
    match /venue_config/{venueId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    match /stadium_config/{stadiumId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // App-wide config (contact details, etc.) - readable by any signed-in
    // user, writable only by admins.
    match /app_config/{docId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // Default-deny: anything not matched above is rejected.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
