rules_version = '2';

// STADIUM - Firestore Security Rules
// Deploy with: firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }

    // Owner of the whole app. Must match kOwnerEmail in lib/main.dart. Requires
    // a verified email, so registering with this address grants nothing.
    function isOwner() {
      return isSignedIn()
        && request.auth.token.email == 'mansourshady69@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isOwner() || (isSignedIn() && request.auth.token.email in [
        'admin@gmail.com',
        'admin.md9@gmail.com',
        'admin.ystadium@gmail.com'
      ]);
    }

    // Court admin: appointed by the owner in court_admins/{email}, limited to
    // the listed courts. Also needs a verified email: an appointment is only
    // an email address, so anyone could otherwise register with it first.
    function managesStadium(stadiumId) {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/court_admins/$(request.auth.token.email))
        && stadiumId in get(/databases/$(database)/documents/court_admins/$(request.auth.token.email)).data.stadiumIds;
    }

    // 1) USERS - each user reads/writes only their own profile.
    match /users/{uid} {
      allow read:   if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // Padel/tennis bookings carry `maxPlayers`; football bookings don't, so
    // these checks are no-ops for them (football behaviour unchanged).
    function withinMaxPlayers() {
      return !('maxPlayers' in request.resource.data)
        || request.resource.data.players.size() <= request.resource.data.maxPlayers;
    }
    function maxPlayersUnchanged() {
      return !('maxPlayers' in resource.data)
        || request.resource.data.get('maxPlayers', null) == resource.data.maxPlayers;
    }

    // 2) BOOKINGS - signed-in users see availability and join with codes.
    match /bookings/{bookingId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn() && withinMaxPlayers();
      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid
        || isAdmin()
        || managesStadium(resource.data.get('stadiumId', ''))
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players'])
      ) && (isAdmin() || (withinMaxPlayers() && maxPlayersUnchanged()));
      allow delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid
        || isAdmin()
        || managesStadium(resource.data.get('stadiumId', ''))
      );
    }

    // Clubs and courts added from the owner's screen. A doc with the id of a
    // code-defined club or court overrides it (active:false hides it).
    match /venues/{venueId} {
      allow read:  if isSignedIn();
      allow write: if isOwner();
    }
    match /stadiums/{stadiumId} {
      allow read:  if isSignedIn();
      allow write: if isOwner();
    }

    // Which courts each admin manages. Doc id is the lowercased email.
    match /court_admins/{email} {
      allow read:  if isOwner() || (isSignedIn() && request.auth.token.email == email);
      allow write: if isOwner();
    }

    // 3) ADMIN_SCHEDULE - per-stadium per-day overrides.
    match /admin_schedule/{docId} {
      allow read:  if isSignedIn();
      // Doc id is {stadiumId}_{yyyy-MM-dd}: the last 11 characters are the date.
      allow write: if isAdmin() || managesStadium(docId[0:docId.size() - 11]);
    }

    // 4) NOTIFICATIONS - each user reads/writes only their own.
    match /notifications/{notifId} {
      allow read:   if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // 5) RECURRING_BLOCKS - weekly fixed reservations.
    match /recurring_blocks/{blockId} {
      allow read:  if isSignedIn();
      allow create: if isAdmin() || managesStadium(request.resource.data.get('stadiumId', ''));
      allow update: if isAdmin() || (
        managesStadium(resource.data.get('stadiumId', ''))
        && managesStadium(request.resource.data.get('stadiumId', ''))
      );
      allow delete: if isAdmin() || managesStadium(resource.data.get('stadiumId', ''));
    }

    // Booking types (per-stadium configurable types).
    match /booking_types/{typeId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // Training groups (kids' programs).
    match /training_groups/{groupId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // Parents register kids - parents see/manage their own; admins manage all.
    match /training_registrations/{regId} {
      allow read:   if isSignedIn() && (
        resource.data.parentUserId == request.auth.uid || isAdmin()
      );
      allow create: if isSignedIn()
        && request.resource.data.parentUserId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.parentUserId == request.auth.uid || isAdmin()
      );
      allow delete: if isSignedIn() && (
        resource.data.parentUserId == request.auth.uid || isAdmin()
      );
    }

    // Venue / stadium background images.
    match /venue_config/{venueId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    match /stadium_config/{stadiumId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // App-wide config (contact details, etc.) - readable by any signed-in
    // user, writable only by admins.
    match /app_config/{docId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // Default-deny: anything not matched above is rejected.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
